{
  "source": "https://www.cukaimax.com/.well-known/mcp",
  "exportedAt": "2026-08-30",
  "serverInfo": {
    "name": "cukaimax-tax-authority",
    "version": "2026-07-31"
  },
  "instructions": "Use this server for source-linked Malaysian individual tax rules. YA2025 Form BE is source-verified by CukaiMax and supports deterministic drafts; YA2025 Form B is source-verified for authority search and preparation-readiness checks, not calculation; YA2026 contains source-verified planning changes but no return fields until official forms exist. Every tool result includes a privacy-safe audit event with immutable release, rule, and source references. Pass the returned event ID into the next audit context to create a replayable chain. Source verification is not official HASiL approval and output is never filed or submitted to MyTax.",
  "capabilities": {
    "tools": {
      "listChanged": true
    },
    "resources": {
      "listChanged": true
    }
  },
  "tools": [
    {
      "name": "list_tax_authority_releases",
      "title": "List Malaysian tax authority releases",
      "description": "Discover supported years, forms, versions, statuses, capabilities, and limitations before selecting a release.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "audit": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string",
                "minLength": 8,
                "maxLength": 128
              },
              "sequence": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "previousEventId": {
                "type": "string",
                "minLength": 8,
                "maxLength": 128
              }
            },
            "required": [
              "runId",
              "sequence"
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "get_tax_authority_release",
      "title": "Get Malaysian tax authority release",
      "description": "Return a supported Form BE or Form B release, its official sources, validation result, review status, and known limitations.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "taxYear": {
            "default": 2025,
            "anyOf": [
              {
                "type": "number",
                "const": 2025
              },
              {
                "type": "number",
                "const": 2026
              }
            ]
          },
          "formType": {
            "default": "BE",
            "anyOf": [
              {
                "type": "string",
                "const": "BE"
              },
              {
                "type": "string",
                "const": "B"
              }
            ]
          },
          "audit": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string",
                "minLength": 8,
                "maxLength": 128
              },
              "sequence": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "previousEventId": {
                "type": "string",
                "minLength": 8,
                "maxLength": 128
              }
            },
            "required": [
              "runId",
              "sequence"
            ]
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "search_tax_authority",
      "title": "Search Malaysian tax rules",
      "description": "Search cited Form BE or Form B rules by topic, field ID, rule ID, or TaxBrain category. Returns official source records with every match.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Tax topic, Form BE field, or TaxBrain category"
          },
          "taxYear": {
            "default": 2025,
            "anyOf": [
              {
                "type": "number",
                "const": 2025
              },
              {
                "type": "number",
                "const": 2026
              }
            ]
          },
          "formType": {
            "default": "BE",
            "anyOf": [
              {
                "type": "string",
                "const": "BE"
              },
              {
                "type": "string",
                "const": "B"
              }
            ]
          },
          "audit": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string",
                "minLength": 8,
                "maxLength": 128
              },
              "sequence": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "previousEventId": {
                "type": "string",
                "minLength": 8,
                "maxLength": 128
              }
            },
            "required": [
              "runId",
              "sequence"
            ]
          }
        },
        "required": [
          "query"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "prepare_be_2025_draft",
      "title": "Prepare Form BE 2025 draft",
      "description": "Compile reviewed taxpayer inputs and a deterministic TaxBrain relief evaluation into source-linked Form BE fields. This tool never stores data or submits to MyTax, and output remains review-gated.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "taxYear": {
            "default": 2025,
            "type": "number",
            "const": 2025
          },
          "assessmentType": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              },
              {
                "type": "number",
                "const": 4
              },
              {
                "type": "number",
                "const": 5
              }
            ],
            "description": "Form BE A6 assessment-type code selected by the taxpayer"
          },
          "assessmentIssuedInTaxpayerName": {
            "description": "Required for A6 code 1 or 2; true only when the joint assessment is issued in this taxpayer\u2019s name",
            "type": "boolean"
          },
          "income": {
            "type": "object",
            "properties": {
              "employmentIncome": {
                "type": "number",
                "minimum": 0
              },
              "employmentCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "malaysiaDividendStatutoryIncome": {
                "type": "number",
                "minimum": 0
              },
              "rentalIncome": {
                "type": "number",
                "minimum": 0
              },
              "otherMalaysiaIncome": {
                "type": "number",
                "minimum": 0
              },
              "foreignIncomeReceivedInMalaysia": {
                "type": "number",
                "minimum": 0
              },
              "catalystInvestmentDeduction": {
                "type": "number",
                "minimum": 0
              },
              "spouseTransferredIncome": {
                "type": "number",
                "minimum": 0
              },
              "spouseDividendStatutoryIncome": {
                "type": "number",
                "minimum": 0
              },
              "spouseAggregateIncome": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "employmentIncome"
            ]
          },
          "donations": {
            "type": "object",
            "properties": {
              "government": {
                "type": "number",
                "minimum": 0
              },
              "approvedInstitution": {
                "type": "number",
                "minimum": 0
              },
              "approvedSportsActivity": {
                "type": "number",
                "minimum": 0
              },
              "projectOfNationalInterest": {
                "type": "number",
                "minimum": 0
              },
              "wakafOrEndowment": {
                "type": "number",
                "minimum": 0
              },
              "artifactsOrManuscripts": {
                "type": "number",
                "minimum": 0
              },
              "libraryFacilities": {
                "type": "number",
                "minimum": 0
              },
              "publicAccessibilityFacilities": {
                "type": "number",
                "minimum": 0
              },
              "approvedMedicalEquipment": {
                "type": "number",
                "minimum": 0
              },
              "nationalOrStateGalleryPaintings": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "credits": {
            "type": "object",
            "properties": {
              "section110Other": {
                "type": "number",
                "minimum": 0
              },
              "section132ForeignTaxRelief": {
                "type": "number",
                "minimum": 0
              },
              "section133ForeignTaxRelief": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "payments": {
            "type": "object",
            "properties": {
              "mtdPcb": {
                "type": "number",
                "minimum": 0
              },
              "section107d": {
                "type": "number",
                "minimum": 0
              },
              "cp500": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "rebates": {
            "type": "object",
            "properties": {
              "zakatAndFitrah": {
                "type": "number",
                "minimum": 0
              },
              "qualifyingDepartureLevy": {
                "type": "number",
                "minimum": 0
              },
              "spouseRebateEligible": {
                "type": "boolean"
              }
            }
          },
          "inputBlockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reliefEvaluation": {
            "type": "object",
            "properties": {
              "taxYear": {
                "type": "number",
                "const": 2025
              },
              "totalClaimableRelief": {
                "type": "number",
                "minimum": 0
              },
              "reliefResults": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "categoryId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "lhdnCode": {
                      "type": "string",
                      "minLength": 1
                    },
                    "claimableAmount": {
                      "type": "number",
                      "minimum": 0
                    },
                    "rawSpend": {
                      "type": "number",
                      "minimum": 0
                    },
                    "eligibilityStatus": {
                      "type": "string",
                      "enum": [
                        "eligible",
                        "not_eligible",
                        "needs_info"
                      ]
                    }
                  },
                  "required": [
                    "categoryId",
                    "lhdnCode",
                    "claimableAmount"
                  ]
                }
              }
            },
            "required": [
              "taxYear",
              "totalClaimableRelief",
              "reliefResults"
            ]
          },
          "audit": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string",
                "minLength": 8,
                "maxLength": 128
              },
              "sequence": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "previousEventId": {
                "type": "string",
                "minLength": 8,
                "maxLength": 128
              }
            },
            "required": [
              "runId",
              "sequence"
            ]
          }
        },
        "required": [
          "assessmentType",
          "income",
          "reliefEvaluation"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "assess_form_b_2025_readiness",
      "title": "Assess Form B 2025 preparation readiness",
      "description": "Check whether the source records, finalised accounts, official worksheets, and conditional schedules needed for manual Form B preparation are ready. This does not calculate or submit Form B.",
      "inputSchema": {
        "type": "object",
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "properties": {
          "taxYear": {
            "default": 2025,
            "type": "number",
            "const": 2025
          },
          "residentIndividual": {
            "type": "boolean"
          },
          "carriesOnBusiness": {
            "type": "boolean"
          },
          "recordsKept": {
            "type": "boolean"
          },
          "businessAccountsReady": {
            "type": "boolean"
          },
          "businessComputationReady": {
            "type": "boolean"
          },
          "capitalAllowanceClaimed": {
            "type": "boolean"
          },
          "capitalAllowanceScheduleReady": {
            "type": "boolean"
          },
          "businessLossClaimed": {
            "type": "boolean"
          },
          "businessLossScheduleReady": {
            "type": "boolean"
          },
          "partnershipIncome": {
            "type": "boolean"
          },
          "partnershipStatementReady": {
            "type": "boolean"
          },
          "foreignIncomeReceivedInMalaysia": {
            "type": "boolean"
          },
          "foreignIncomeScheduleReady": {
            "type": "boolean"
          },
          "incentiveClaim": {
            "type": "boolean"
          },
          "incentiveApprovalReady": {
            "type": "boolean"
          },
          "assessmentType": {
            "anyOf": [
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              },
              {
                "type": "number",
                "const": 4
              },
              {
                "type": "number",
                "const": 5
              }
            ]
          },
          "assessmentIssuedInTaxpayerName": {
            "type": "boolean"
          },
          "personalReliefEvidenceReady": {
            "type": "boolean"
          },
          "taxPaymentRecordsReady": {
            "type": "boolean"
          },
          "audit": {
            "type": "object",
            "properties": {
              "runId": {
                "type": "string",
                "minLength": 8,
                "maxLength": 128
              },
              "sequence": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "previousEventId": {
                "type": "string",
                "minLength": 8,
                "maxLength": 128
              }
            },
            "required": [
              "runId",
              "sequence"
            ]
          }
        },
        "required": [
          "residentIndividual",
          "carriesOnBusiness",
          "recordsKept",
          "businessAccountsReady",
          "businessComputationReady",
          "assessmentType",
          "personalReliefEvidenceReady",
          "taxPaymentRecordsReady"
        ]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    }
  ],
  "resources": [
    {
